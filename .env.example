# Documentation only: Anvesha does not automatically load .env files.
# Set these in your shell. Never commit real keys or private documents.
ANVESHA_DB_PATH=.anvesha/anvesha.db
ANVESHA_API_KEYS=replace-with-a-key-from-anvesha-init
ANVESHA_ENABLED_SOURCES=local
ANVESHA_WORKER_POLL_SECONDS=1
# ANV-026: new searches expire seven days after acceptance; 0 means indefinite.
# Existing saved configs without this field retain indefinite behavior; existing
# job deadlines are never changed by this environment variable.
ANVESHA_RETENTION_SECONDS=604800
# Optional live metadata source, enabled with local,wikidata above:
# ANVESHA_WIKIDATA_USER_AGENT=Anvesha/0.1 (mailto:your-real-contact@example.org)
# ANV-022: new requests default to LLM ranking. Configure a model or explicitly
# send ranking=lexical. Set these identically in legacy API/worker shells.
# Native setup saves effective settings to private configuration instead.
# Use a model already installed in your runtime; Anvesha downloads none.
# ANVESHA_LLM_MODEL=your-installed-model-name
# ANVESHA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Optional OmniRoute endpoint: http://127.0.0.1:20128/v1
# A local gateway may route to cloud models. Verify its route and fallback policy.
# ANVESHA_LLM_API_KEY=your-private-runtime-or-gateway-key
# ANVESHA_LLM_ALLOW_NETWORK=false
# ANVESHA_LLM_TIMEOUT_SECONDS=60
# ANVESHA_LLM_CANDIDATE_LIMIT=20
# ANV-023: opt in only when your runtime supports schema-constrained output.
# ANVESHA_LLM_OUTPUT_FORMAT=json_schema
# ANV-024: opt-in per-candidate ordinal grading; listwise remains the default.
# ANVESHA_LLM_STRATEGY=pointwise
# ANVESHA_CONFIG_PATH=.anvesha/server.json
