# Documentation only: Anvesha does not automatically load .env files.
# Set these in your shell. Never commit real keys or private documents.
ANVESHA_DB_PATH=.anvesha/anvesha.db
ANVESHA_API_KEYS=replace-with-a-key-from-anvesha-init
ANVESHA_ENABLED_SOURCES=local
ANVESHA_WORKER_POLL_SECONDS=1
# Optional live metadata source, enabled with local,wikidata above:
# ANVESHA_WIKIDATA_USER_AGENT=Anvesha/0.1 (mailto:your-real-contact@example.org)
